# =============================================================================
# TripRadar.cz — Environment Variables
# Zkopíruj do .env.local a vyplň hodnoty
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NIKDY NEXT_PUBLIC!

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MYSTERY_MONTHLY_PRICE_ID=price_...
STRIPE_MYSTERY_YEARLY_PRICE_ID=price_...

# Ecomail
ECOMAIL_API_KEY=your-ecomail-api-key
ECOMAIL_LIST_ID=your-list-id

# Resend (transakční emaily)
RESEND_API_KEY=re_...

# Payload CMS
PAYLOAD_SECRET=your-random-32-char-secret-here
DATABASE_URI=postgresql://user:password@host:5432/tripradar

# App
NEXT_PUBLIC_BASE_URL=https://tripradar.cz
